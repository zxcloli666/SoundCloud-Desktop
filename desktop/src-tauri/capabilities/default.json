{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "tray-popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "core:window:allow-scale-factor",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        },
        {
          "url": "ms-settings:*"
        }
      ]
    },
    "dialog:default",
    "fs:allow-exists",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA"
        }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/import-history.json"
        },
        {
          "path": "$APPDATA/import-session.json"
        },
        {
          "path": "$APPDATA/import-sync.json"
        },
        {
          "path": "$APPDATA/news.json"
        },
        {
          "path": "$APPDATA/offline-index.json"
        },
        {
          "path": "$APPDATA/sc-app-status.json"
        },
        {
          "path": "$APPDATA/sc-blocked-artists.json"
        },
        {
          "path": "$APPDATA/sc-chat-backdrop.json"
        },
        {
          "path": "$APPDATA/sc-chat-prefs.json"
        },
        {
          "path": "$APPDATA/sc-effects.json"
        },
        {
          "path": "$APPDATA/sc-local-library.json"
        },
        {
          "path": "$APPDATA/sc-player.json"
        },
        {
          "path": "$APPDATA/sc-releases-seen.json"
        },
        {
          "path": "$APPDATA/sc-search-history.json"
        },
        {
          "path": "$APPDATA/sc-search-prefs.json"
        },
        {
          "path": "$APPDATA/sc-settings.json"
        },
        {
          "path": "$APPDATA/sc-themes.json"
        },
        {
          "path": "$APPDATA/sc-track-sound.json"
        },
        {
          "path": "$APPDATA/sc-voice.json"
        },
        {
          "path": "$APPDATA/star-moments.json"
        },
        {
          "path": "$APPDATA/ym-import-owned.json"
        },
        {
          "path": "$APPDATA/ym-import-pending.json"
        },
        {
          "path": "$APPDATA/css-assets"
        },
        {
          "path": "$APPDATA/css-assets/*"
        },
        {
          "path": "$APPDATA/fonts"
        },
        {
          "path": "$APPDATA/fonts/*"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        },
        {
          "path": "$APPCACHE/wallpapers"
        },
        {
          "path": "$APPCACHE/wallpapers/*"
        }
      ],
      "deny": [
        {
          "path": "$APPDATA/sc-auth.json"
        },
        {
          "path": "$APPDATA/chat"
        },
        {
          "path": "$APPDATA/chat/**"
        },
        {
          "path": "$APPDATA/chat-dev"
        },
        {
          "path": "$APPDATA/chat-dev/**"
        }
      ]
    }
  ]
}
