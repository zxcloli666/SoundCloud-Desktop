{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "tray-popover"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "core:window:allow-scale-factor",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.scnative.space"
        },
        {
          "url": "https://stream.scnative.space"
        },
        {
          "url": "https://images.scnative.space"
        },
        {
          "url": "https://storage.scnative.space"
        },
        {
          "url": "https://*.relay.scnative.space"
        },
        {
          "url": "https://*.sndcdn.com"
        },
        {
          "url": "https://*.soundcloud.com"
        },
        {
          "url": "https://www.gstatic.com"
        },
        {
          "url": "https://detectportal.firefox.com"
        },
        {
          "url": "https://www.cloudflare.com"
        },
        {
          "url": "http://*.localhost:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    }
  ]
}
