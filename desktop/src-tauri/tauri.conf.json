{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soundcloud-desktop",
  "version": "8.4.10",
  "identifier": "com.soundcloud.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundCloud Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 470,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://*.localhost:* ws://localhost:* ws://127.0.0.1:* scproxy:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* http://*.localhost:* scproxy: blob: data: https:",
        "media-src": "'self' http://127.0.0.1:* http://*.localhost:* scproxy: blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
