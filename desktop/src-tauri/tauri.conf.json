{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soundcloud-desktop",
  "version": "8.8.0",
  "identifier": "com.soundcloud.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SoundCloud Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 470,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: scproxy: chatmedia: http://127.0.0.1:* http://*.localhost:* https://images.scnative.dev https://images.scnative.space https://i1.sndcdn.com https://a1.sndcdn.com",
        "media-src": "'self' data: blob: scproxy: chatmedia: http://127.0.0.1:*",
        "font-src": "'self' data: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* scproxy: http://*.localhost:*",
        "frame-src": "http://127.0.0.1:*/overlay",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/autostart.wxs"],
        "componentGroupRefs": ["AutostartCleanup"]
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
