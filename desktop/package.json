{
  "name": "sonveil-desktop",
  "private": true,
  "version": "8.4.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-backend-config.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:cef": "cargo build --manifest-path src-tauri/Cargo.toml --features cef && cp -ru \"$(find src-tauri/target/debug/build -type d -path '*cef-dll-sys*/out/cef_linux_x86_64' | head -1)/.\" src-tauri/target/debug/ && tauri dev -f cef -- -- --no-sandbox --ozone-platform=x11",
    "lint": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-fs": "2.5.0",
    "@tauri-apps/plugin-http": "2.5.8",
    "@tauri-apps/plugin-opener": "2.5.3",
    "i18next": "^26.0.3",
    "lucide-react": "^1.7.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.0",
    "react-router-dom": "^7.14.0",
    "simple-icons": "^16.15.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tauri-apps/cli": "2.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
